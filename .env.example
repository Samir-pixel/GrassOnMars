# Application
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATA_DIR=./data

# PostgreSQL + PostGIS
POSTGRES_USER=marswalk
POSTGRES_PASSWORD=marswalk_dev_password
POSTGRES_DB=marswalk
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional explicit override; otherwise assembled from POSTGRES_* variables
DATABASE_URL=

# Google Gemini API (server-side only, never exposed to frontend)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend build/runtime config
VITE_API_BASE_URL=http://localhost:8000
